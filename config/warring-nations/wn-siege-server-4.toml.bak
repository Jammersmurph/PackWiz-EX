#Warring Nations Siege: master + per-module toggles.
#Each module makes one target mod obey WN claim/war protection: block changes are
#denied in foreign claims at peace, and allowed against enemy claims during a declared war.
[general]
	#Master switch. When false, no module does anything.
	enabled = true

[create_big_cannons]
	#Enforce siege rules on Create Big Cannons shells, autocannon rounds,
	#shrapnel, and shell explosions. Also covers the CC:CBC ComputerCraft compat
	#(it only fires existing CBC cannons, no mixin of its own needed).
	enabled = true

[cbc_more_shells]
	#Enforce siege rules on CBC Military Supplement (mod id
	#cbcmoreshells): dual-cannon shells, racked rockets/bombs, torpedoes, and the
	#anti-air machine gun. These munitions reimplement block penetration themselves
	#and never call CBC's own canDamageTerrain hook, so this module also plugs that
	#pre-existing grief-protection gap, not just WN-awareness.
	enabled = true

[create]
	#Enforce siege rules on Create automation that bypasses block events:
	#drills, saws, mechanical rollers, harvesters, and moving contraption breakers.
	enabled = true
	#Also guard blocks a contraption drops into the world on
	#disassembly (contraption block placement across borders). Best-effort attribution
	#by the contraption's current chunk; disable if it interferes with legitimate parking.
	guard_contraption_placement = true
	#Also guard blocks a moving Mechanical Roller paves into the world
	#(track-laying / material-fill ahead of the roller). Separate from
	#guard_contraption_placement above, which is scoped to disassembly placement only;
	#disable this one if it interferes with legitimate roller use across your own
	#claim boundary.
	guard_roller_paving = true

[tacz]
	#Enforce siege rules on TaCZ fire-starting ammo (raw fire block placement).
	#TaCZ explosive ammo/grenades are handled by the shared explosion filter below.
	enabled = true

[railways]
	#Enforce siege rules on Create: Steam 'n' Rails' own Roller
	#extension (track-laying / track-material replacement), which diverts around
	#Create's own Roller paving path this addon already gates.
	enabled = true

[explosions]
	#Per-block filter for vanilla-routed explosions (Create Nuclear reactor
	#meltdown, TaCZ explosive rounds/grenades, and any other mod that routes through
	#Level.explode). Claimed blocks survive unless the blast's nation is at war with the
	#owner. Does not touch Create Big Cannons' own explosions (handled by the CBC module).
	enabled = true

[warnautics]
	#Enforce siege rules on Create: Warnautics (mod id cbc_more_content)
	#aerial bombs and land mines. Its bomb blasts drive their own explosion lifecycle
	#directly instead of calling CBC's shared canDamageTerrain choke point, so this
	#module also plugs that pre-existing grief-protection gap, not just WN-awareness
	#(same situation as cbc_more_shells above). Its small-shrapnel mine variant already
	#routes through CBC's shared explosion handler and is covered by the CBC module.
	enabled = true

[superb_warfare]
	#Enforce siege rules on Superb Warfare (mod id superbwarfare) rockets,
	#cannon shells, mines, and C4: several of its projectile/mine classes call
	#Level#destroyBlock directly for single- or multi-block impact destruction
	#(separate from, and in addition to, its full-radius explosion blast, which
	#already fires the standard NeoForge explosion event and needs no module of its
	#own). Vehicle-fired shots already attribute correctly to the real gunner via
	#vanilla's own Projectile#getOwner(), no module needed for that half either.
	enabled = true

[warborn_explosives]
	#Enforce siege rules on WarBorn Explosives (mod id warbornexplosives,
	#a Superb Warfare add-on): its shrapnel entity destroys glass blocks/panes
	#directly (the exact TaCZ glass-shatter pattern), and its Tm62M mine adds a
	#second manual block-destroy pass on top of its already-covered explosion
	#blast. Its regular grenade and other mine types need nothing (no block damage
	#attempted, or already routed through the covered Superb Warfare explosion).
	enabled = true

[weapons_and_tools]
	#Enforce siege rules on Weapons And Tools (mod id weapon_and_tools_):
	#its Magic Wand's laser mode places raw fire/soul-fire with no event, letting
	#vanilla fire spread do ungated damage. Melee weapons and the wand's ball mode
	#need nothing (effect-only, or already an event-firing vanilla explosion).
	enabled = true

[pyrotechnics]
	#Enforce siege rules on Pyrotechnics (mod id pyrotechnics): its thrown
	#Sticky Grenade plants a live primed-grenade block on impact with no event,
	#before its later (already-covered) delayed detonation. Every other explosive
	#in this mod already routes through a real vanilla explosion and needs nothing.
	enabled = true

[immersive_weapons]
	#Enforce siege rules on Immersive Weapons (mod id immersiveweapons):
	#its bullets destroy glass blocks/panes directly on impact (the TaCZ
	#glass-shatter pattern). Its mortar, meteor staff, and landmine already route
	#through real vanilla explosions and need nothing.
	enabled = true

[point_blank]
	#Enforce siege rules on Point Blank (mod id pointblank, 8.2M
	#downloads, the single most-used mod in this addon's whole compat list): its
	#own CustomExplosion class never fires a NeoForge explosion event at all (own
	#private toBlow field, never delegates to vanilla's own blow-list machinery),
	#and its hitscan guns destroy thin blocks (glass etc) directly, the TaCZ
	#glass-shatter pattern.
	enabled = true

[cbc_neo_warfare]
	#Enforce siege rules on CBC Neo Warfare (mod id cbcmodernwarfare), a
	#Create Big Cannons addon. Its Big Cannon shells and autocannon rounds already
	#extend CBC's own gated classes and need no module-specific code; its new Medium
	#Cannon shell class extends AbstractCannonProjectile directly (a sibling of, not a
	#descendant of, the classes the CBC module already covers) and reimplements block
	#penetration with a raw setBlock call that never reaches CBC's own canDamageTerrain
	#gate. Its unmanned munitions-carrying Create contraption has the same raw-setBlock
	#gap, attributed via controller/train/chunk-owner resolution since it has no
	#projectile owner of its own.
	enabled = true

[just_enough_guns]
	#Enforce siege rules on Just Enough Guns (mod id jeg): its shared
	#SpecialExplosion utility (payload drones, C4 vests, placed explosives, faction
	#bomber fire) threads a real owner through the whole call chain but discards it
	#right before the block-destroying blast itself, passing null instead -- a real
	#self-attribution loophole that this module repairs. Explosive-ammo bullets and
	#penetrating rounds, flaming arrows, and molotov/grenade fire spread are also
	#covered, each gated by the real shooter/thrower's owner. Dynamic-light muzzle
	#flash effects and the water bomb's fire-suppression effect need nothing (cosmetic
	#or purely defensive, no claimed-block destruction).
	enabled = true

[insane_tnt]
	#Enforce siege rules on Insane TNT (mod id insanetnt): seven of
	#its ~36 TNT/nuke block variants (Ice, Glitch, Magic Slime, Slime, Sponge,
	#Subzero, Transformation) dispatch raw permission-level-4 /fill commands across
	#areas up to 63 blocks wide, bypassing block events entirely -- no vanilla
	#explosion is ever fired, so the addon's generic explosion handler never sees
	#them. This module gates each one at its command-dispatch call site, checked per
	#chunk across the whole affected area. The other ~29 variants already route
	#through a real vanilla explosion and are presumed covered by the existing
	#generic handler the same way Create Nuclear's reactor meltdown already is --
	#verify this with a live-boot test before fully trusting it, this hasn't been
	#confirmed in-game yet.
	enabled = true

[bmnw]
	#Enforce siege rules on BMNW (mod id bmnw, Bunkers Machines & Nuclear
	#Weapons): all 5 nuke types (Caseoh, Dropped Soulfire Bomb, Little Boy, Nuclear
	#Charge, Tsar Bomba) funnel through the exact same shared crater-carving handler,
	#which carves a chunk-radius blast with zero events and zero attribution --
	#the highest-severity gap found in this addon's whole compat sweep. Attributed via
	#chunk-owner-of-impact, the same null-source fallback the generic explosion
	#handler uses, since the falling bomb tracks no owner at all and can drift before
	#detonating.
	enabled = true

[ballistix]
	#Enforce siege rules on Ballistix (mod id ballistix, 1.3M
	#downloads): its shared canBreakBlockState choke point (used by 10 of its ~25
	#blast types) already fires a real BlockEvent.BreakEvent but only checks
	#GriefDefender, no Warring Nations awareness at all -- gated directly at that
	#choke point rather than a new blanket global block-break listener. Also covers
	#BlastRejuvination (regenerates an entire target chunk from fresh world-gen
	#data with zero permission check at all -- the single most severe finding in
	#this addon's whole compat sweep) and BlastAntigravity (raw block-launching,
	#bypasses the shared choke point its own siblings use). Ballistix's missile
	#system tracks no owner anywhere in its data model from launch to impact --
	#a real gap, left undesigned for now rather than rushing an invasive fix that
	#would need new persistent state in the mod's own save schema; see the wn-siege
	#README for details.
	enabled = true

[scorched_guns]
	#Enforce siege rules on ScorchedGuns (mod id scguns): fragile-block
	#(glass) breaking is covered on the base projectile class, inherited by nearly
	#every bullet type; the Krahg Round, Osborne Slug, and Fire Round's sculk-clear
	#each have their own separate raw block-break call; the Scamp Tank and Scamp
	#Rocket hostile mobs terrain-break with no owner; the Penetrator block's tunnel
	#reaches past its own placement point. Also covers the mod's mining laser gun,
	#which fires block-breaking beams directly against whatever a real player's
	#raycast hits with NO permission check at all -- the single highest-severity
	#gap found in this addon's whole compat sweep, since unlike every other gap it's
	#fired directly by a named player, not an edge-case projectile.
	enabled = true
