[connection]
	#Master switch. If false, the bridge stays a no-op and never connects.
	enabled = false
	#Bot token. PREFER the env var WN_DISCORD_BOT_TOKEN; if set it overrides this.
	botToken = ""
	#The Discord server (guild) id.
	guildId = ""
	#Role id whose members may run admin slash commands / console commands.
	staffRoleId = ""
	#The bot's Discord presence/activity text, refreshed every 60s. Placeholders: %online% %max%. Blank = no activity text shown.
	presenceFormat = "%online% / %max% players"

[channels]
	#Channel id for two-way player chat.
	chat = ""
	#Channel id for the console mirror.
	console = ""
	#Channel id for join/leave/death/advancement/start-stop.
	events = ""
	#Extra channels for addon feeds, as "key=channelId" (e.g. "nation=123456789").
	extra = []

[textCommands]
	#Chat-message alternative to slash commands, e.g. "!wn nation list" or the bare "!whitelist add Steve". Every registered command works both ways.
	enabled = true
	#Prefix a message must start with to be tried as a command. Works namespaced ("<prefix>wn <command> [args]") or bare ("<prefix><command> [args]").
	prefix = "!"
	#Channel ids where "!" text commands are never dispatched (the message just relays/posts normally instead). Slash commands are unaffected. Manage with "/setup ignore-add|ignore-remove|ignore-list", or list channel ids here directly.
	ignoredChannels = []
	#If non-empty, "!" text commands ONLY work in these channel ids -- elsewhere a recognised command name gets a redirect reply instead of running. Empty (default) means no restriction. Manage with "/setup restrict-add|restrict-remove|restrict-list".
	restrictedChannels = []

[relay]
	#Relay in-game chat to Discord.
	mcToDiscord = true
	#Relay Discord chat into the game.
	discordToMc = true
	#Use channel webhooks so relayed chat shows the player's name + avatar.
	useWebhooks = true
	#Mirror the server console/log into the console channel.
	consoleEnabled = false
	#Allow running server commands from the console channel (staff only).
	consoleAllowCommands = false
	#Optional prefix a console-channel message must start with to run as a command (empty = any line).
	consoleCommandPrefix = ""
	#Discord->MC only: collapse consecutive identical messages into a "(+N)" counter line instead of relaying the full text again each time.
	duplicateCollapseEnabled = true
	#How long (seconds) a repeat must follow the previous identical message within to be collapsed; older repeats relay in full again.
	# Default: 45
	# Range: 1 ~ 3600
	duplicateCollapseWindowSeconds = 45

[filter]
	#Basic content filtering for the two-way chat relay (both directions). Deliberately scoped down: a short severe-slur blocklist, Discord invite-link stripping (anti-advertising), mass-mention neutralisation, and simple per-user flood control. NOT a full moderation/strike/mute/ban system.
	#Block relayed messages that contain a word from slurBlocklist below.
	slurFilterEnabled = true
	#Case-insensitive slur blocklist (also catches common leetspeak/spacing evasion, e.g. "n-i-g-g-3r"). This is the one place to tune it: edit freely, no rebuild required. Keep it to the most severe slurs only; this is deliberately not a general profanity filter.
	slurBlocklist = ["nigger", "nigga", "faggot"]
	#Block relayed messages containing a discord.gg/... or discord.com/invite/... invite link (anti-advertising).
	inviteLinkFilterEnabled = true
	#Neutralise @everyone/@here in relayed content so it can never mass-ping.
	massMentionFilterEnabled = true
	#Per-user flood control: once a user exceeds rateLimitMaxMessages within rateLimitWindowSeconds, further messages in that window are silently dropped from the relay (not an escalating punishment, just a short window).
	rateLimitEnabled = true
	#Max messages allowed per user within the window before extras are dropped.
	# Default: 5
	# Range: 1 ~ 1000
	rateLimitMaxMessages = 5
	#Sliding window size, in seconds, for the flood check.
	# Default: 10
	# Range: 1 ~ 3600
	rateLimitWindowSeconds = 10

[announcements]
	#Announce player joins.
	join = true
	#Announce player leaves.
	leave = true
	#Announce player deaths.
	death = true
	#Announce advancements.
	advancement = true
	#Announce server start/stop.
	serverStartStop = true

[templates]
	#Message templates. Supported placeholders include %player% %message% %user% %advancement% and any registered by addons.
	mcChatToDiscord = "%player% » %message%"
	#Discord -> Minecraft chat line. Wrap any part in &#RRGGBB ... &r to color it, e.g. the default below colors just the word Discord blue (#3B82F6).
	discordChatToMc = "[Discord] %user%: %message%"
	join = ":inbox_tray: **%player%** joined the game"
	leave = ":outbox_tray: **%player%** left the game"
	death = ":skull: %message%"
	advancement = ":trophy: **%player%** earned the advancement **%advancement%**"
	serverStart = ":white_check_mark: Server started"
	serverStop = ":octagonal_sign: Server stopped"
	#Optional embed form for join/leave/death/advancement/serverStart/serverStop. Off by default (the plain-text templates above are used unchanged). color is a hex string (with or without '#') or a %placeholder%; empty = no color (client default).
	joinAsEmbed = false
	joinEmbedTitle = ""
	joinEmbedDescription = ":inbox_tray: **%player%** joined the game"
	joinEmbedColor = ""
	joinEmbedFooter = ""
	joinEmbedFields = []
	leaveAsEmbed = false
	leaveEmbedTitle = ""
	leaveEmbedDescription = ":outbox_tray: **%player%** left the game"
	leaveEmbedColor = ""
	leaveEmbedFooter = ""
	leaveEmbedFields = []
	deathAsEmbed = false
	deathEmbedTitle = ""
	deathEmbedDescription = ":skull: %message%"
	deathEmbedColor = ""
	deathEmbedFooter = ""
	deathEmbedFields = []
	advancementAsEmbed = false
	advancementEmbedTitle = ""
	advancementEmbedDescription = ":trophy: **%player%** earned the advancement **%advancement%**"
	advancementEmbedColor = ""
	advancementEmbedFooter = ""
	advancementEmbedFields = []
	serverStartAsEmbed = false
	serverStartEmbedTitle = ""
	serverStartEmbedDescription = ":white_check_mark: Server started"
	serverStartEmbedColor = ""
	serverStartEmbedFooter = ""
	serverStartEmbedFields = []
	serverStopAsEmbed = false
	serverStopEmbedTitle = ""
	serverStopEmbedDescription = ":octagonal_sign: Server stopped"
	serverStopEmbedColor = ""
	serverStopEmbedFooter = ""
	serverStopEmbedFields = []

[linking]
	#Enable Discord OAuth2 account linking (/discord link).
	enabled = false
	#OAuth2 application client id.
	clientId = ""
	#OAuth2 client secret. PREFER env var WN_DISCORD_CLIENT_SECRET.
	clientSecret = ""
	#Registered redirect URI. Must exactly match the Discord app + point at this server's callback.
	redirectUri = "http://localhost:9955/callback"
	#Host/interface the embedded OAuth callback server binds to.
	callbackBindHost = "0.0.0.0"
	#Port the embedded OAuth callback server listens on.
	# Default: 9955
	# Range: 1 ~ 65535
	callbackPort = 9955
	#Require a linked Discord account to play (kick unlinked players with a link URL).
	requireLinkedToPlay = false

[roleSync]
	#Enable Discord role <-> in-game group sync (requires linked accounts).
	enabled = false
	#Role id granted to linked server operators.
	opRoleId = ""
	#Role id granted to any linked player.
	linkedRoleId = ""
	#Auto-create/assign a Discord role per Warring Nations nation (= FTB party team).
	nationRolesAuto = false

[warringNations]
	#Publish Warring Nations nation/war/diplomacy feeds to Discord.
	feedsEnabled = true
	#Bridge per-nation in-game chat (/nation msg) to a per-nation Discord channel. RESERVED: WN's public API does not yet fire an event for /nation msg, so this currently has no effect regardless of value. See the README's "known gaps" section.
	nationChatBridge = false
	#Auto-create a private Discord channel per nation (visible only to a same-named nation role) on founding, archived on disband. Requires the bot to have Manage Channels + Manage Roles. A nation renamed in-game will also rename its Discord channel/role.
	perNationChannelsEnabled = false
	#Optional category id new nation channels are created under. Empty = no category.
	nationChannelCategoryId = ""
	#On NationDisbanded, lock (deny sending) and rename the nation's channel to "archived-..." instead of deleting it, preserving history. If false, the channel is left untouched.
	archiveNationChannelsOnDisband = true

[alerts]
	#DiscordSRV-style scheduled announcements: rotates through "messages" on a timer, independent of any game event. Supports the same %placeholders% as other templates (without a player context, so %nation% etc. resolve empty).
	#Enable scheduled announcements.
	enabled = false
	#Seconds between announcements.
	# Default: 3600
	# Range: 60 ~ 86400
	intervalSeconds = 3600
	#Logical channel key to post announcements to (e.g. "events", "chat", or an extra key).
	channel = "events"
	#Messages to rotate through, in order. Empty = feature is a no-op even if enabled.
	messages = []

[wnTemplates]
	#Templates for every Warring Nations nation/war/diplomacy feed embed (see WnFeeds) plus nation role/channel naming. Every default below reproduces today's compiled-in wording and color exactly. color values are a hex string (with or without '#') or a %placeholder% that renders to one; empty defers to the event's own computed default (e.g. a nation's own color for nation-branded embeds). See the README's "Warring Nations feed placeholders" section for the exact %token% set each event exposes.
	#Discord role name for a nation. Default reproduces today's raw nation name.
	roleNameTemplate = "%nation%"
	nationChannelWelcomeMessage = ":tada: **%nation%**'s nation channel is live."
	nationChannelTopicTemplate = "Private channel for the nation of %nation%"
	#Plain prefix (not a %placeholder% template) prepended to a nation channel's name on disband archival.
	archivedChannelPrefix = "archived-"
	#Placeholders: %nation% %founder%.
	nationCreatedTitle = "🏛 Nation founded"
	nationCreatedDescription = "**%nation%** was founded by **%founder%**"
	nationCreatedColor = ""
	#Placeholders: %nation%.
	nationDisbandedTitle = "🏚 Nation disbanded"
	nationDisbandedDescription = "**%nation%** has been disbanded"
	nationDisbandedColor = "747F8D"
	#Placeholders: %old_nation% %nation% (new name).
	nationRenamedTitle = "✏ Nation renamed"
	nationRenamedDescription = "**%old_nation%** is now known as **%nation%**"
	nationRenamedColor = ""
	#Placeholders: %player% %nation%.
	memberJoinedTitle = "➕ Member joined"
	memberJoinedDescription = "**%player%** joined **%nation%**"
	memberJoinedColor = ""
	#Placeholders: %player% %nation%.
	memberLeftTitle = "➖ Member left"
	memberLeftDescription = "**%player%** left **%nation%**"
	memberLeftColor = ""
	#Placeholders: %capturer% %chunk_x% %chunk_z% %dimension%.
	chunkCaptureStartedTitle = "⚠ Territory under attack!"
	chunkCaptureStartedDescription = "**%capturer%** is capturing your chunk at `%chunk_x%, %chunk_z%` in `%dimension%`, get there now!"
	chunkCaptureStartedColor = "F04747"
	#Placeholders: %capturer% %chunk_x% %chunk_z% %dimension%.
	chunkCaptureInterruptedTitle = "🛡 Capture repelled"
	chunkCaptureInterruptedDescription = "**%capturer%**'s capture attempt at `%chunk_x%, %chunk_z%` in `%dimension%` was interrupted"
	chunkCaptureInterruptedColor = "43B581"
	#Placeholders: %nation% %chunk_x% %chunk_z% %dimension%.
	claimChangedTitle = "📍 Territory captured"
	claimChangedDescription = "**%nation%** captured a chunk at `%chunk_x%, %chunk_z%` in `%dimension%`"
	claimChangedColor = "FAA61A"
	#Used instead of claimChangedTitle/Description/Color above when 2+ chunks
	#change ownership for the same at-war nation in one batch (e.g. a large war-frontline
	#push). Placeholders: %nation% %count%.
	claimChangedBulkTitle = "📍 Territory captured"
	claimChangedBulkDescription = "**%nation%** captured %count% chunks"
	claimChangedBulkColor = "FAA61A"
	#Placeholders: %founder% %nation%. Buttons/thumbnail stay hardcoded.
	nationCreationPendingTitle = "🏛 Nation creation pending approval"
	nationCreationPendingDescription = "**%founder%** wants to found **%nation%**"
	nationCreationPendingColor = "FAA61A"
	nationCreationPendingFooter = "Use the buttons below to approve or deny this request"
	#Placeholders: %submitter% %nation%. Buttons/thumbnail stay hardcoded.
	bannerPendingTitle = "🎨 Banner pending approval"
	bannerPendingDescription = "**%submitter%** submitted a new banner for **%nation%**"
	bannerPendingColor = ""
	bannerPendingFooter = "Use the buttons below to approve or deny this banner"
	#Placeholders: %attacker% %defender% %model% %model_full%. Buttons stay hardcoded.
	warPendingApprovalTitle = "⏳ War pending approval"
	warPendingApprovalDescription = "**%attacker%** declared war on **%defender%** (%model_full%)"
	warPendingApprovalColor = "FF7043"
	warPendingApprovalFooter = "Use the buttons below or /war approve in Discord"
	#The 6 approve/deny confirmations below all take one placeholder: %staff%.
	warApprovedTitle = "✅ War approved"
	warApprovedDescription = "Approved by **%staff%**"
	warApprovedColor = "43B581"
	warDeniedTitle = "❌ War denied"
	warDeniedDescription = "Denied by **%staff%**"
	warDeniedColor = "F04747"
	nationCreationApprovedTitle = "✅ Nation creation approved"
	nationCreationApprovedDescription = "Approved by **%staff%**"
	nationCreationApprovedColor = "43B581"
	nationCreationDeniedTitle = "❌ Nation creation denied"
	nationCreationDeniedDescription = "Denied by **%staff%**"
	nationCreationDeniedColor = "F04747"
	bannerApprovedTitle = "✅ Banner approved"
	bannerApprovedDescription = "Approved by **%staff%**"
	bannerApprovedColor = "43B581"
	bannerDeniedTitle = "❌ Banner denied"
	bannerDeniedDescription = "Denied by **%staff%**"
	bannerDeniedColor = "F04747"
	#Placeholders: %attacker% %defender% %model% %model_full%. The scroll GIF stays hardcoded.
	warDeclaredTitle = "⚔ War Declared"
	warDeclaredDescription = "**%attacker%** vs **%defender%**\r\n%model_full% war"
	warDeclaredColor = "FF7043"
	#The Discord scheduled-event text. Placeholders: %attacker% %defender% %model_full%.
	warScheduledEventTitle = "War: %attacker% vs %defender%"
	warScheduledEventDescription = "%model_full%, join the server to participate"
	#The live war scoreboard, edited throughout the war. 4 structural phases (declared/active/ended/won) each with their own Title/Color; Description/ScoreFieldValue/Footer below are shared. Placeholders: %attacker% %defender% %model% %model_full%, plus %score_line% (Java-computed) and %winner% (won phase only).
	warStatusDeclaredTitle = "⚔ %attacker% vs %defender%"
	warStatusDeclaredColor = "FF7043"
	warStatusActiveTitle = "⚔ %attacker% vs %defender%"
	warStatusActiveColor = "F04747"
	warStatusEndedTitle = "🕊 War ended"
	warStatusEndedColor = "747F8D"
	warStatusWonTitle = "🏆 %winner% won"
	warStatusWonColor = "FAA61A"
	warStatusDescription = "%model_full% war"
	warStatusScoreFieldValue = "%score_line%"
	warStatusFooter = "Updates every 30 s while the war is active"
	#Placeholders: %for_nation% %vs_nation% %model% %model_full% %ready_count% %out_count%, plus %responses% (Java-computed: the formatted ready/out list).
	rollcallTitle = "📯 Rollcall: %for_nation% vs %vs_nation%"
	rollcallDescription = "**%model_full%** war, who's playing?"
	rollcallColor = "F04747"
	rollcallFieldName = "Responses (%ready_count% in, %out_count% out)"
	rollcallFieldValue = "%responses%"
	#Post-war breakdown embed. 2 structural variants (won/no-winner) each with their own Title/Color; Description/fields below are shared. Placeholders: %attacker% %defender% %model% %model_full% %winner% (won only) %attacker_score% %defender_score% %end_reason% %chunks_annexed%. The winner's banner thumbnail stays hardcoded.
	warResolvedWonTitle = "🏆 %winner% won"
	warResolvedWonColor = "FAA61A"
	warResolvedNoWinnerTitle = "🕊 War ended"
	warResolvedNoWinnerColor = "747F8D"
	warResolvedDescription = "**%attacker%** vs **%defender%**, %model_full%"
	warResolvedScoreFieldName = "Score"
	warResolvedScoreFieldValue = "%attacker%: **%attacker_score%** | %defender%: **%defender_score%**"
	warResolvedReasonFieldName = "Reason"
	warResolvedReasonFieldValue = "%end_reason%"
	warResolvedChunksFieldName = "Chunks annexed"
	warResolvedChunksFieldValue = "%chunks_annexed%"
	#The 3 relation-changed variants (ally/enemy/neutral) below each take %nation_a% %nation_b%.
	relationAllyTitle = "🤝 Diplomacy"
	relationAllyDescription = "**%nation_a%** and **%nation_b%** are now allied"
	relationAllyColor = "43B581"
	relationEnemyTitle = "🤝 Diplomacy"
	relationEnemyDescription = "**%nation_a%** and **%nation_b%** are now enemies"
	relationEnemyColor = "F04747"
	relationNeutralTitle = "🤝 Diplomacy"
	relationNeutralDescription = "**%nation_a%** and **%nation_b%** are now neutral"
	relationNeutralColor = "5865F2"

[commandTemplates]
	#Titles/colors/static copy for the slash (and equivalent ! text) commands' reply embeds. Live list/table bodies (nation rosters, leaderboard rows, claim coordinates, help text) stay computed, not templated, same reasoning as [wnTemplates]'s rollcall response list. color values are a hex string (with or without '#') or a %placeholder%.
	#/server online. Placeholders: %online% %max%.
	onlineTitle = "Players online (%online%/%max%)"
	onlineColor = "5865F2"
	onlineEmptyDescription = "Nobody is online right now."
	#/nations list. Placeholders: %count%.
	nationsTitle = "Nations (%count%)"
	nationsEmptyTitle = "Nations"
	nationsEmptyDescription = "No nations exist yet."
	nationsColor = "5865F2"
	#/nation info. Placeholders: %nation%.
	nationTitle = "🏛 %nation%"
	nationColorAtWar = "F04747"
	nationColorPeace = "43B581"
	nationAtWarYes = "Yes ⚔"
	nationAtWarNo = "No"
	#/war list.
	warsEmptyTitle = "🕊 No active wars"
	warsTitle = "⚔ Nations at war"
	warsEmptyDescription = "All is quiet."
	warsEmptyColor = "43B581"
	warsColor = "F04747"
	#/account whois, /account whoami. Placeholders: %player%.
	whoisTitle = "👤 %player%"
	whoisColor = "5865F2"
	#/nations roster. Placeholders: %nation% %count%.
	rosterTitle = "👥 %nation% (%count% member(s))"
	rosterEmptyDescription = "No members."
	rosterColor = "5865F2"
	#/nations chunk.
	claimUnclaimedTitle = "📍 Unclaimed"
	claimUnclaimedColor = "43B581"
	#Placeholders: %nation%.
	claimOwnedTitle = "📍 %nation%"
	claimOwnedColor = "5865F2"
	#/nations compare. Placeholders: %nation_a% %nation_b%.
	compareTitle = "%nation_a% ↔ %nation_b%"
	compareAtWarText = "⚔ At war"
	compareAtWarColor = "F04747"
	compareAlliedText = "🤝 Allied"
	compareAlliedColor = "43B581"
	compareNeutralText = "Neutral"
	compareNeutralColor = "5865F2"
	#/nations leaderboard. Placeholders: %metric% ("claims" or "members").
	leaderboardTitle = "🏆 Leaderboard (by %metric%)"
	leaderboardEmptyTitle = "Leaderboard"
	leaderboardEmptyDescription = "No nations exist yet."
	leaderboardColor = "FAA61A"
	leaderboardEmptyColor = "5865F2"
	#/staff claims (staff only). Placeholders: %nation% %count%.
	claimsListTitle = "📍 %nation% (%count% claim(s))"
	claimsListEmptyDescription = "No claims."
	claimsListColor = "5865F2"
	#/nations history. Placeholders: %nation%.
	historyTitle = "📜 %nation%'s war history"
	historyEmptyTitle = "📜 %nation%"
	historyEmptyDescription = "No past wars."
	historyColor = "5865F2"
	#/server status.
	serverStatusTitle = "🖥 Server status"
	serverStatusColor = "5865F2"
	#/whitelist <sub> (staff only). Placeholders: %count% where shown.
	whitelistListTitle = "📋 Whitelist (%count%)"
	whitelistEmptyDescription = "Empty."
	whitelistListColor = "5865F2"
	whitelistAddedTitle = "✅ Whitelisted"
	whitelistAddedColor = "43B581"
	whitelistRemovedTitle = "❌ Removed"
	whitelistRemovedColor = "F04747"
	whitelistOnTitle = "✅ Whitelist enabled"
	whitelistOnColor = "43B581"
	whitelistOffTitle = "❌ Whitelist disabled"
	whitelistOffColor = "F04747"
	whitelistReloadedTitle = "🔄 Whitelist reloaded"
	whitelistReloadedColor = "5865F2"
	#/war rally. Placeholders: %nation%.
	rallyTitle = "📯 Rally: %nation%"
	rallyDescription = "**%nation%** is calling for battle!"
	rallyColor = "F04747"
	#/help (no args). Placeholders: %count%.
	helpTitle = "📖 Commands (%count%)"
	#/help (no args) footer. Placeholders: %prefix% (the configured text-command prefix, see textCommands.prefix).
	helpFooter = "Run \"/help <command>\" for full usage. Also usable as text: \"!<command> --help\", \"!wn <command> [args]\", or bare \"!<command> [args]\""
	helpColor = "5865F2"
	#/help <command>. Placeholders: %command%.
	commandHelpTitle = "📖 /%command%"
	commandHelpColor = "5865F2"
	#/debug (staff only); each subcommand appends its own name to this title.
	debugTitle = "🩺 Diagnostics"
	debugColor = "5865F2"
	#The generic reply shape used by every subcommand that bridges straight to an in-game /wn command (nation invite/kick/rename/..., diplomacy, war declare/status/..., /staff stats): a green "done" embed when the command produced no output, else a blue embed of the raw in-game feedback lines.
	bridgedDoneDescription = "Done."
	bridgedDoneColor = "43B581"
	bridgedColor = "5865F2"
	#The shared error-embed wrapper every command's failure/validation messages use. Only the title/color are configurable; the message bodies themselves are short parameterized diagnostic text (e.g. "No nation named X found."), not brand copy.
	errorTitle = ""
	errorColor = "F04747"
	#/nations villages. Placeholders: %nation% %count%. %nation% is "the server" when no nation was given.
	villagesTitle = "🏘 Villages of %nation% (%count%)"
	villagesEmptyDescription = "No villages."
	villagesColor = "5865F2"
	#/war stats. Placeholders: %player%.
	warStatsTitle = "⚔ War stats: %player%"
	warStatsEmptyDescription = "No recorded war activity."
	warStatsColor = "5865F2"
	#/nations graph. Placeholders: %nation%. %nation% is "leaderboard" when no nation was given.
	graphTitle = "📈 Growth: %nation%"
	graphColor = "FAA61A"

[linkTemplates]
	#Account-linking flow: in-game /discord chat messages, the requireLinkedToPlay kick messages, and the OAuth callback web pages (HTML/CSS shell fixed, only title/body text is templated). In-game messages support &#RRGGBB...&r color tokens layered on top of that message's default semantic color, same mechanism as [templates].discordChatToMc.
	linkNotEnabledMessage = "Discord account linking is not enabled on this server."
	linkAlreadyLinkedMessage = "Your account is already linked. Use /discord unlink first."
	linkFailedMessage = "Could not start linking. Try again shortly."
	linkPromptMessage = "Open this link in your browser (expires in a few minutes):"
	linkButtonText = "» Click here to link your Discord account «"
	unlinkNotAvailableMessage = "Discord linking is not available right now."
	unlinkSuccessMessage = "Your Discord account has been unlinked."
	unlinkNotLinkedMessage = "You do not have a linked Discord account."
	statusNotEnabledMessage = "Discord linking is not enabled on this server."
	#Placeholders: %id% (the linked Discord snowflake).
	statusLinkedMessage = "Linked to Discord id %id%."
	statusNotLinkedMessage = "Not linked. Run /discord link to connect your account."
	reloadSuccessMessage = "WN Discord bridge reloaded from config."
	#Placeholders: %error%.
	reloadFailedMessage = "Reload failed: %error%"
	#Kick message when requireLinkedToPlay is on and the joining player has no linked Discord account. Placeholders: %url% (the one-click authorize link).
	requireLinkKickMessage = "Link your Discord account to play:\r\n%url%"
	requireLinkUnavailableMessage = "This server requires a linked Discord account, but linking is unavailable. Contact staff."
	oauthMethodNotAllowedTitle = "Method not allowed"
	oauthMethodNotAllowedBody = "Use the link Discord sent you."
	oauthCancelledTitle = "Link cancelled"
	#Placeholders: %error% (Discord's own error code, HTML-escaped).
	oauthCancelledBody = "Discord returned: %error%."
	oauthInvalidRequestTitle = "Invalid request"
	oauthInvalidRequestBody = "Missing code or state. Start again with /discord link in game."
	oauthNotMemberTitle = "Not a server member"
	oauthNotMemberBody = "You authorized Discord, but you're not a member of this server yet. Join the Discord server first, then run /discord link again in Minecraft."
	oauthLinkedTitle = "Linked!"
	#Placeholders: %name% (the linked Minecraft username, HTML-escaped).
	oauthLinkedBody = "Your Discord account is now linked to <b>%name%</b>. You can close this tab and return to Minecraft."
	oauthExpiredTitle = "Link expired"
	oauthExpiredBody = "That link request expired or was already used. Run /discord link in game to get a fresh link."
	oauthErrorTitle = "Something went wrong"
	oauthErrorBody = "Could not complete the link. Please try again."

[commandGates]
	#Generic fallback replies shared by every slash command AND its equivalent ! text command (unknown command/subcommand, permission gates, unhandled exceptions).
	unknownCommandMessage = "Unknown command."
	unknownSubcommandMessage = "Unknown subcommand."
	#The ! text-command form of unknownSubcommandMessage, richer since it can list the valid options. Placeholders: %subcommand% %options% %prefix% %command%.
	unknownSubcommandTextMessage = "Unknown subcommand \"%subcommand%\". Options: %options%. Run \"%prefix%help %command%\" for details."
	requireLinkMessage = "Link your Minecraft account first, then run **/discord link** in game."
	adminOnlyMessage = "You don't have permission to use this command."
	#Placeholders: %error% (the thrown exception's simple class name).
	commandFailedMessage = "Command failed: %error%"
