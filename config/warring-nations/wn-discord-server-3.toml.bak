[connection]
	#Master switch. If false, the bridge stays a no-op and never connects.
	enabled = false
	#Bot token. PREFER the env var WN_DISCORD_BOT_TOKEN; if set it overrides this.
	botToken = ""
	#The Discord server (guild) id.
	guildId = ""
	#Role id whose members may run admin slash commands / console commands.
	staffRoleId = ""

[channels]
	#Channel id for two-way player chat.
	chat = ""
	#Channel id for the console mirror.
	console = ""
	#Channel id for join/leave/death/advancement/start-stop.
	events = ""
	#Extra channels for addon feeds, as "key=channelId" (e.g. "nation=123456789").
	extra = []

[textCommands]
	#Chat-message alternative to slash commands, e.g. "!wn nation list" or the bare "!whitelist add Steve". Every registered command works both ways.
	enabled = true
	#Prefix a message must start with to be tried as a command. Works namespaced ("<prefix>wn <command> [args]") or bare ("<prefix><command> [args]").
	prefix = "!"

[relay]
	#Relay in-game chat to Discord.
	mcToDiscord = true
	#Relay Discord chat into the game.
	discordToMc = true
	#Use channel webhooks so relayed chat shows the player's name + avatar.
	useWebhooks = true
	#Mirror the server console/log into the console channel.
	consoleEnabled = false
	#Allow running server commands from the console channel (staff only).
	consoleAllowCommands = false
	#Optional prefix a console-channel message must start with to run as a command (empty = any line).
	consoleCommandPrefix = ""
	#Discord->MC only: collapse consecutive identical messages into a "(+N)" counter line instead of relaying the full text again each time.
	duplicateCollapseEnabled = true
	#How long (seconds) a repeat must follow the previous identical message within to be collapsed; older repeats relay in full again.
	# Default: 45
	# Range: 1 ~ 3600
	duplicateCollapseWindowSeconds = 45

[filter]
	#Basic content filtering for the two-way chat relay (both directions). Deliberately scoped down: a short severe-slur blocklist, Discord invite-link stripping (anti-advertising), mass-mention neutralisation, and simple per-user flood control. NOT a full moderation/strike/mute/ban system.
	#Block relayed messages that contain a word from slurBlocklist below.
	slurFilterEnabled = true
	#Case-insensitive slur blocklist (also catches common leetspeak/spacing evasion, e.g. "n-i-g-g-3r"). This is the one place to tune it: edit freely, no rebuild required. Keep it to the most severe slurs only; this is deliberately not a general profanity filter.
	slurBlocklist = ["nigger", "nigga", "faggot"]
	#Block relayed messages containing a discord.gg/... or discord.com/invite/... invite link (anti-advertising).
	inviteLinkFilterEnabled = true
	#Neutralise @everyone/@here in relayed content so it can never mass-ping.
	massMentionFilterEnabled = true
	#Per-user flood control: once a user exceeds rateLimitMaxMessages within rateLimitWindowSeconds, further messages in that window are silently dropped from the relay (not an escalating punishment, just a short window).
	rateLimitEnabled = true
	#Max messages allowed per user within the window before extras are dropped.
	# Default: 5
	# Range: 1 ~ 1000
	rateLimitMaxMessages = 5
	#Sliding window size, in seconds, for the flood check.
	# Default: 10
	# Range: 1 ~ 3600
	rateLimitWindowSeconds = 10

[announcements]
	#Announce player joins.
	join = true
	#Announce player leaves.
	leave = true
	#Announce player deaths.
	death = true
	#Announce advancements.
	advancement = true
	#Announce server start/stop.
	serverStartStop = true

[templates]
	#Message templates. Supported placeholders include %player% %message% %user% %advancement% and any registered by addons.
	mcChatToDiscord = "%player% » %message%"
	discordChatToMc = "[Discord] %user%: %message%"
	join = ":inbox_tray: **%player%** joined the game"
	leave = ":outbox_tray: **%player%** left the game"
	death = ":skull: %message%"
	advancement = ":trophy: **%player%** earned the advancement **%advancement%**"
	serverStart = ":white_check_mark: Server started"
	serverStop = ":octagonal_sign: Server stopped"

[linking]
	#Enable Discord OAuth2 account linking (/discord link).
	enabled = false
	#OAuth2 application client id.
	clientId = ""
	#OAuth2 client secret. PREFER env var WN_DISCORD_CLIENT_SECRET.
	clientSecret = ""
	#Registered redirect URI. Must exactly match the Discord app + point at this server's callback.
	redirectUri = "http://localhost:9955/callback"
	#Host/interface the embedded OAuth callback server binds to.
	callbackBindHost = "0.0.0.0"
	#Port the embedded OAuth callback server listens on.
	# Default: 9955
	# Range: 1 ~ 65535
	callbackPort = 9955
	#Require a linked Discord account to play (kick unlinked players with a link URL).
	requireLinkedToPlay = false

[roleSync]
	#Enable Discord role <-> in-game group sync (requires linked accounts).
	enabled = false
	#Role id granted to linked server operators.
	opRoleId = ""
	#Role id granted to any linked player.
	linkedRoleId = ""
	#Auto-create/assign a Discord role per Warring Nations nation (= FTB party team).
	nationRolesAuto = false

[warringNations]
	#Publish Warring Nations nation/war/diplomacy feeds to Discord.
	feedsEnabled = true
	#Bridge per-nation in-game chat (/nation msg) to a per-nation Discord channel. RESERVED: WN's public API does not yet fire an event for /nation msg, so this currently has no effect regardless of value. See the README's "known gaps" section.
	nationChatBridge = false
	#Auto-create a private Discord channel per nation (visible only to a same-named nation role) on founding, archived on disband. Requires the bot to have Manage Channels + Manage Roles. A nation renamed in-game will also rename its Discord channel/role.
	perNationChannelsEnabled = false
	#Optional category id new nation channels are created under. Empty = no category.
	nationChannelCategoryId = ""
	#On NationDisbanded, lock (deny sending) and rename the nation's channel to "archived-..." instead of deleting it, preserving history. If false, the channel is left untouched.
	archiveNationChannelsOnDisband = true

[alerts]
	#DiscordSRV-style scheduled announcements: rotates through "messages" on a timer, independent of any game event. Supports the same %placeholders% as other templates (without a player context, so %nation% etc. resolve empty).
	#Enable scheduled announcements.
	enabled = false
	#Seconds between announcements.
	# Default: 3600
	# Range: 60 ~ 86400
	intervalSeconds = 3600
	#Logical channel key to post announcements to (e.g. "events", "chat", or an extra key).
	channel = "events"
	#Messages to rotate through, in order. Empty = feature is a no-op even if enabled.
	messages = []
